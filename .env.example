# === Kết nối ZFitDB (SQL Server / Express) — copy thành file .env ===

DB_DATABASE=ZFitDB
DB_SERVER=localhost

# SQL Express: bật service "SQL Server Browser" (services.msc)
DB_INSTANCE=SQLEXPRESS

# --- Windows Authentication (user Windows, giống SSMS) ---
DB_USE_WINDOWS_AUTH=true

# Instance mặc định (không Express): comment dòng DB_INSTANCE=SQLEXPRESS

# Tuỳ chọn
# DB_ENCRYPT=true
# DB_PORT=1433
# DB_CONNECTION_TIMEOUT_MS=30000

# --- SQL login (Mixed Mode + KetNoiDB.sql) ---
# DB_USE_WINDOWS_AUTH=false
# DB_USER=ZFit
# DB_PASSWORD=ZFit@123456

PORT=5000
