# Kết nối ZFitDB — SQL Express + Windows Auth
DB_USE_WINDOWS_AUTH=true
DB_SERVER=127.0.0.1
DB_INSTANCE=
DB_PORT=1434
DB_DATABASE=ZFitDB

# Nếu vẫn báo timeout: thử đổi DB_SERVER=localhost và comment DB_PORT
# Hoặc dùng SQL Authentication thay vì Windows Auth:
# DB_USE_WINDOWS_AUTH=false
# DB_USER=sa
# DB_PASSWORD=yourPassword
# DB_SERVER=127.0.0.1
# DB_INSTANCE=
# DB_PORT=1434
# DB_DATABASE=ZFitDB

# DB_ENCRYPT=true
# DB_CONNECTION_TIMEOUT_MS=90000

PORT=5000
